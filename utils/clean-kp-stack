#!/bin/bash
NS=monitoring
KP_DEPLOYMENTS=$(kubectl get deployment -n $NS | awk 'NR > 1 {print $1}')
KP_STATEFULSET=$(kubectl get statefulset -n $NS | awk 'NR > 1 {print $1}')
KP_DAEMONSET=$(kubectl get daemonset -n $NS | awk 'NR > 1 {print $1}')
KP_PVC=$(kubectl get pvc -n $NS | awk 'NR > 1 {print $1}')
KP_SECRETS=$(kubectl get secrets -n $NS | awk 'NR > 1 {print $1}')
KP_CM=$(kubectl get configmap -n $NS | awk 'NR > 1 {print $1}')
KP_SA=$(kubectl get serviceaccount -n $NS | awk 'NR > 1 {print $1}')
KP_SVC=$(kubectl get svc -n $NS | awk 'NR > 1 {print $1}')
KP_ROLES=$(kubectl get roles -n $NS | awk 'NR > 1 {print $1}')
KP_CROLES=$(kubectl get clusterroles | grep -E "kp-stack|kube-prometheus" | awk 'NR > 1 {print $1}')
KP_RB=$(kubectl get rolebinding -n $NS | awk 'NR > 1 {print $1}')
KP_CRB=$(kubectl get clusterrolebinding -n $NS | grep -E "kp-stack|kube-prometheus" | awk 'NR > 1 {print $1}')

# Delete stuck Resources
kubectl patch job kp-stack-admission-patch -n $NS --type=json -p='[{"op": "remove", "path": "/metadata/finalizers"}]'
kubectl patch job kp-stack-admission-create -n $NS --type=json -p='[{"op": "remove", "path": "/metadata/finalizers"}]'
kubectl patch serviceaccount $SA -n $NS --type=json -p='[{"op": "remove", "path": "/metadata/finalizers"}]'
kubectl patch roles $ROLES -n $NS --type=json -p='[{"op": "remove", "path": "/metadata/finalizers"}]'
kubectl patch rolebinding $RB -n $NS --type=json -p='[{"op": "remove", "path": "/metadata/finalizers"}]'
kubectl patch clusterrole $CROLES -n $NS --type=json -p='[{"op": "remove", "path": "/metadata/finalizers"}]'
kubectl patch clusterrolebinding $CRB -n $NS --type=json -p='[{"op": "remove", "path": "/metadata/finalizers"}]'

# Delete Resources by namespaced
K8S_RESOURCES=(deployment statefulset daemonset service pvc secrets roles clusterroles rolebinding clusterrolebinding serviceaccount configmap)
KP_RESOURCES=(KP_DEPLOYMENTS KP_STATEFULSET KP_DAEMONSET KP_SECRETS KP_CM KP_SA KP_SVC KP_ROLES KP_CROLES KP_RB KP_CRB)
kubectl scale deployment --replicas=0 -n $NS $KP_DEPLOYMENTS
kubectl delete deployment -n $NS $KP_DEPLOYMENTS
kubectl scale statefulset --replicas=0 -n $NS $KP_STATEFULSET
kubectl delete statefulset -n $NS $KP_STATEFULSET

kubectl delete daemonset -n $NS $KP_DAEMONSET
kubectl delete service -n $NS $KP_SVC
kubectl delete pvc -n $NS $KP_PVC
kubectl delete secrets -n $NS $KP_SECRETS
kubectl delete roles -n $NS $KP_ROLES
kubectl delete clusterroles -n $NS $KP_CROLES
kubectl delete rolebinding -n $NS $KP_RB
kubectl delete clusterrolebinding -n $NS $KP_CRB
kubectl delete serviceaccount -n $NS $KP_SA
kubectl delete configmap -n $NS $KP_CM

# 1. Delete the mutating and validating webhooks
kubectl delete validatingwebhookconfiguration kp-stack-admission --ignore-not-found
kubectl delete mutatingwebhookconfiguration kp-stack-admission --ignore-not-found

# 2. Delete the leftover admission patch jobs and pods
kubectl delete jobs -n $NS -l app=kp-stack-admission
kubectl delete pods -n $NS -l app=kp-stack-admission
kubectl delete job kp-stack-admission-create -n $NS --ignore-not-found
kubectl delete job kp-stack-admission-patch -n $NS --ignore-not-found

# 3. Delete the stubborn admission secret
kubectl delete secret kp-stack-admission -n $NS --ignore-not-found

# Delete Custom Resources
#kubectl delete crd -l app=kp-stack
kubectl delete crd alertmanagerconfigs.$NS.coreos.com
kubectl delete crd alertmanagers.$NS.coreos.com
kubectl delete crd podmonitors.$NS.coreos.com
kubectl delete crd probes.$NS.coreos.com
kubectl delete crd prometheusagents.$NS.coreos.com
kubectl delete crd prometheuses.$NS.coreos.com
kubectl delete crd prometheusrules.$NS.coreos.com
kubectl delete crd scrapeconfigs.$NS.coreos.com
kubectl delete crd servicemonitors.$NS.coreos.com
kubectl delete crd thanosrulers.$NS.coreos.com
