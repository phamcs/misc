#!/bin/bash
# Define Argo-Events vars
AENS=argo-events
AE_DEPLOYMENTS=$(kubectl get deployment -n $AENS | awk 'NR > 1 {print $1}')
AE_STATEFULSET=$(kubectl get statefulset -n $AENS | awk 'NR > 1 {print $1}')
AE_DAEMONSET=$(kubectl get daemonset -n $AENS | awk 'NR > 1 {print $1}')
AE_PVC=$(kubectl get pvc -n $AENS | awk 'NR > 1 {print $1}')
AE_SECRETS=$(kubectl get secrets -n $AENS | awk 'NR > 1 {print $1}')
AE_CM=$(kubectl get configmap -n $AENS | awk 'NR > 1 {print $1}')
AE_SA=$(kubectl get serviceaccount -n $AENS | awk 'NR > 1 {print $1}')
AE_SVC=$(kubectl get svc -n $AENS | awk 'NR > 1 {print $1}')
AE_ROLES=$(kubectl get roles | grep -E "argo-events-*" | awk 'NR > 1 {print $1}')
AE_CROLES=$(kubectl get clusterroles | grep -E "argo-events-*" | awk 'NR > 1 {print $1}')
AE_RB=$(kubectl get rolebinding | grep -E "argo-events-*" | awk 'NR > 1 {print $1}')
AE_CRB=$(kubectl get clusterrolebinding |grep -E "argo-events-*"|awk 'NR > 1 {print $1}')

# Delete Argo-Events stuck resources
kubectl get apps -n $AENS -o jsonpath='{.items[*].metadata.name}' | xargs -I {} kubectl patch app {} -n $AENS -p '{"metadata":{"finalizers":null}}' --type merge
kubectl patch eventsource webhook-event-source -n $AENS --type merge -p '{"metadata":{"finalizers":null}}'
kubectl delete eventsource webhook-event-source -n $AENS --grace-period=0 --force
kubectl patch eventsource github-webhook -n $AENS --type merge -p '{"metadata":{"finalizers":null}}'
kubectl delete eventsource github-webhook -n $AENS --grace-period=0 --force
kubectl patch eventsensor webhook -n $AENS --type merge -p '{"metadata":{"finalizers":null}}'
kubectl delete eventsensor webhook -n $AENS --grace-period=0 --force
kubectl patch sensor ci-trigger -n $AENS --type merge -p '{"metadata":{"finalizers":null}}'
kubectl delete sensor ci-trigger -n $AENS --grace-period=0 --force
kubectl patch sensor webhook -n $AENS --type merge -p '{"metadata":{"finalizers":null}}'
kubectl delete sensor webhook -n $AENS --grace-period=0 --force
kubectl patch sensor eventbus-controller -n $AENS --type merge -p '{"metadata":{"finalizers":null}}'
kubectl delete eventbus eventbus-controller -n $AENS --grace-period=0 --force
kubectl patch eventbus default -n $AENS --type merge -p '{"metadata":{"finalizers":null}}'
kubectl delete eventbus default -n $AENS --grace-period=0 --force


# Delete Argo-Events resources by namespaced
kubectl scale deployment --replicas=0 -n $AENS $AE_DEPLOYMENTS
kubectl delete deployment -n $AENS $AE_DEPLOYMENTS
kubectl scale statefulset --replicas=0 -n $AENS  $AE_STATEFULSET
kubectl delete statefulset -n $AENS $AE_STATEFULSET
kubectl delete daemonset -n $AENS $AE_DAEMONSET
kubectl delete service -n $AENS $AE_SVC
kubectl delete pvc -n $AENS $AE_PVC
kubectl delete secrets -n $AENS $AE_SECRETS
kubectl delete roles $AE_ROLES
kubectl delete clusterroles $AE_CROLES
kubectl delete rolebinding $AE_RB
kubectl delete clusterrolebinding $AE_CRB
kubectl delete serviceaccount -n $AENS $AE_SA
kubectl delete configmap -n $AENS $AE_CM

