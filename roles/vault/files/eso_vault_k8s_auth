# Setup Kubernetes Auth for vault
vault auth enable kubernetes

# Configure Kubernetes auth
vault write auth/kubernetes/config \
  token_reviewer_jwt="$(kubectl get secret external-secrets -n external-secrets -o go-template='{{ .data.token }}' | base64 --decode)" \
  kubernetes_host="$(kubectl config view --raw --minify --flatten --output='jsonpath={.clusters[0].cluster.server}')" \
  kubernetes_ca_cert="$(kubectl config view --raw --minify --flatten --output='jsonpath={.clusters[0].cluster.certificate-authority-data}' | base64 --decode)" \
  disable_local_ca_jwt=true

vault read auth/kubernetes/config

# Create policy
vault policy write external-secrets - <<EOF
path "secret/data/*" {
  capabilities = ["create", "read", "update", "list", "delete"]
}
path "secret/metadata/*" {
  capabilities = ["create", "read", "update", "list", "delete"]
}
# List, create, update, and delete kubernetes secrets
path "kubernetes/*" {
  capabilities = ["create", "read", "update", "delete", "list", "sudo"]
}
EOF

# Enable KV v2 secrets engine
vault secrets enable kubernetes

vault write kubernetes/config \
  kubernetes_host="$(kubectl config view --raw --minify --flatten --output='jsonpath={.clusters[0].cluster.server}')" \
  kubernetes_ca_cert="$(kubectl config view --raw --minify --flatten --output='jsonpath={.clusters[0].cluster.certificate-authority-data}' | base64 --decode)" \
  service_account_jwt="$(kubectl get secret external-secrets -n external-secrets -o go-template='{{ .data.token }}' | base64 --decode)"


# Configure Kubernetes external-secrets role
vault write auth/kubernetes/role/external-secrets \
  bound_service_account_names=external-secrets \
  bound_service_account_namespaces=external-secrets \
  policies=external-secrets \
  ttl=1h

# Testing vault auth with eso-sa token
TOKEN_REVIEW_SJWT=$(kubectl get secret external-secrets -n external-secrets -o go-template='{{ .data.token }}' | base64 --decode)
curl \
  --request POST \
  --data '{"jwt": "'$TOKEN_REVIEW_SJWT'", "role": "external-secrets"}' \
  https://vault.superasian.net/v1/auth/kubernetes/login

# Create Cluster-Store-Secret for vault backend
cat <<EOF | kubectl apply -f -
---
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: vault-backend
spec:
  provider:
    vault:
      server: "https://vault.superasian.net"
      path: "secret"
      version: "v2"
      auth:
        kubernetes:
          mountPath: "kubernetes"
          role: "external-secrets"
          serviceAccountRef:
            name: external-secrets
            namespace: external-secrets
EOF
cat <<EOF | kubectl apply -f -
