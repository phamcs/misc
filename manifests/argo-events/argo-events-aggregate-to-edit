kind: ClusterRole
apiVersion: rbac.authorization.k8s.io/v1
metadata:
  name: argo-events-aggregate-to-edit
  labels:
    rbac.authorization.k8s.io/aggregate-to-edit: 'true'
  annotations:
    argocd.argoproj.io/tracking-id: >-
      argo-events:rbac.authorization.k8s.io/ClusterRole:argo-events/argo-events-aggregate-to-edit
rules:
  - verbs:
      - create
      - delete
      - deletecollection
      - get
      - list
      - patch
      - update
      - watch
    apiGroups:
      - argoproj.io
    resources:
      - sensors
      - sensors/finalizers
      - sensors/status
      - eventsources
      - eventsources/finalizers
      - eventsources/status
      - eventbus
      - eventbus/finalizers
      - eventbus/status